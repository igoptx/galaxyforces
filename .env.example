GALAXY_PORT=8088
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=galaxy
MYSQL_PASSWORD=galaxy
GALAXY_ADMIN_LOGIN=admin
GALAXY_ADMIN_PASSWORD=admin
GALAXY_ADMIN_EMAIL=admin@localhost
# password pedida ao apagar contas antigas ou clãs no painel de admin (vazio = desativado)
GALAXY_ADMIN_CONFIRM=
# segundos por ciclo de jogo em cada universo
# (não mudar num universo já em curso: desloca todas as datas do jogo)
MILKYWAY_TICK=300
ANDROMEDA_TICK=60
# idioma quando o browser não pede um disponível (en, pl, pt)
GALAXY_DEFAULT_LANGUAGE=pt
# tema visual: nova (moderno) ou galaxy (original)
GALAXY_STYLE=nova
# modo de depuração: 1 mostra erros e tempos de render; vazio = produção
GALAXY_DEBUG=
